Project {{PROJECT_IDENTIFIER}} {
  Note: '''
  依 {{INPUT_SOURCES_AND_CONFIRMED_DECISIONS}}。
  本檔為本輪模型與資料規則的唯一來源；{{DATA_OWNERSHIP_AND_MODEL_APPLICABILITY}}。
  交易：{{SHARED_TRANSACTION_CONCURRENCY_AND_RETRY_CONSTRAINTS}}
  授權：{{TRUSTED_INPUT_GRANTS_AND_POLICY_ENFORCEMENT}}
  投影：{{AUTHORITATIVE_READS_VISIBILITY_AND_SERVICE_CONTRACT_REFERENCE}}
  未決：{{PLAN_REFERENCE_AND_LOCAL_IMPACT_OR_STANDALONE_LIMITATIONS}}
  演進：{{CURRENT_SCOPE_MIGRATION_LIFECYCLE_AND_RECOVERY_CONSISTENCY}}
  關鍵待驗證：{{REQUIRED_DATA_RULE_EXPECTATIONS_AND_EXECUTION_BOUNDARY}}
  '''
}

// 可重複的枚舉與成員區塊
Enum {{ENUM_NAME}} {
  {{ENUM_MEMBER}} [note: '{{ENUM_MEMBER_MEANING}}']
}

// 可重複的引用占位區塊
Table {{REFERENCED_TABLE_NAME}} {
  {{REFERENCED_KEY_COLUMN}} {{REFERENCED_KEY_TYPE}} [pk, not null, note: '{{CONFIRMED_REFERENCE_KEY_SOURCE}}']
  Note: '引用表占位；{{REFERENCE_AUTHORITY_AND_IMPORTED_SCOPE}}'
}

// 可重複的本輪模型區塊；欄位、索引及約束區塊各自可重複
Table {{OWNED_TABLE_NAME}} {
  {{KEY_COLUMN_NAME}} {{KEY_COLUMN_TYPE}} [not null, note: '{{KEY_PURPOSE_AND_SOURCE}}']
  {{REQUIRED_COLUMN_NAME}} {{REQUIRED_COLUMN_TYPE}} [not null, note: '{{REQUIRED_COLUMN_MEANING}}']
  {{OPTIONAL_COLUMN_NAME}} {{OPTIONAL_COLUMN_TYPE}} [null, note: '{{OPTIONAL_COLUMN_NULL_MEANING}}']
  {{DEFAULTED_COLUMN_NAME}} {{DEFAULTED_COLUMN_TYPE}} [not null, default: {{DEFAULT_VALUE_EXPRESSION}}, note: '{{DEFAULT_SOURCE_AND_UPDATE_MEANING}}']
  {{CONSTRAINED_COLUMN_NAME}} {{CONSTRAINED_COLUMN_TYPE}} [not null, check: `{{COLUMN_CHECK_EXPRESSION}}`, note: '{{VALUE_DOMAIN_AND_ENFORCEMENT_LIMIT}}']

  indexes {
    ({{PRIMARY_KEY_COLUMN_LIST}}) [pk, name: '{{PRIMARY_KEY_NAME}}']
    ({{UNIQUE_KEY_COLUMN_LIST}}) [unique, name: '{{UNIQUE_KEY_NAME}}']
    ({{INDEX_COLUMN_LIST}}) [name: '{{INDEX_NAME}}']
  }

  checks {
    `{{TABLE_CHECK_EXPRESSION}}` [name: '{{TABLE_CHECK_NAME}}']
  }

  Note: '''
  {{TABLE_PURPOSE_OWNERSHIP_AND_RULE_SOURCES}}
  {{READ_WRITE_GUARDS_STATE_TRANSITIONS_AND_RESULTS}}
  {{LOCAL_TRANSACTION_CONCURRENCY_AND_RETRY_RULES}}
  {{LOCAL_AUTHORIZATION_VISIBILITY_AND_LIFECYCLE_LIMITS}}
  '''
}

// 可重複的單欄或複合參照區塊
Ref {{SINGLE_REFERENCE_NAME}}: {{SOURCE_TABLE}}.{{SOURCE_COLUMN}} > {{TARGET_TABLE}}.{{TARGET_COLUMN}}
Ref {{COMPOSITE_REFERENCE_NAME}}: {{COMPOSITE_SOURCE_TABLE}}.({{COMPOSITE_SOURCE_COLUMNS}}) > {{COMPOSITE_TARGET_TABLE}}.({{COMPOSITE_TARGET_COLUMNS}})
